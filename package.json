{
  "name": "@thiepn/languages",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:hub": "node scripts/build-hub.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm build:hub",
    "package:consumer": "mkdir -p artifacts && pnpm pack --pack-destination artifacts",
    "compat:consumers": "node scripts/check-consumer-compatibility.mjs",
    "p12:audit": "node scripts/p12-production-audit.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "@playwright/test": "1.63.0"
  },
  "files": [
    "packages/consumer-contract/dist/**",
    "packages/read-model/dist/**",
    "packages/dashboard/dist/**",
    "packages/shell/dist/**",
    "contracts/p8-language-read-model.schema.json",
    "contracts/p9-language-dashboard.schema.json",
    "packages/ai-client/src/index.ts",
    "packages/ai-client/dist/index.js",
    "packages/ai-client/dist/browser.js",
    "README.md",
    "docs/P7_ACCEPTANCE.md",
    "docs/P8_ACCEPTANCE.md",
    "docs/P9_ACCEPTANCE.md",
    "docs/P10_ACCEPTANCE.md",
    "docs/P11_ACCEPTANCE.md",
    "docs/P12_ACCEPTANCE.md"
  ],
  "exports": {
    "./consumer-contract": {
      "types": "./packages/consumer-contract/dist/index.d.ts",
      "import": "./packages/consumer-contract/dist/index.js",
      "default": "./packages/consumer-contract/dist/index.js"
    },
    "./consumer-contract/browser": "./packages/consumer-contract/dist/browser.js",
    "./read-model": {
      "types": "./packages/read-model/dist/index.d.ts",
      "import": "./packages/read-model/dist/index.js",
      "default": "./packages/read-model/dist/index.js"
    },
    "./read-model/browser": "./packages/read-model/dist/browser.js",
    "./dashboard": {
      "types": "./packages/dashboard/dist/index.d.ts",
      "import": "./packages/dashboard/dist/index.js",
      "default": "./packages/dashboard/dist/index.js"
    },
    "./dashboard/browser": "./packages/dashboard/dist/browser.js",
    "./shell": {
      "types": "./packages/shell/dist/index.d.ts",
      "import": "./packages/shell/dist/index.js",
      "default": "./packages/shell/dist/index.js"
    },
    "./shell/browser": "./packages/shell/dist/browser.js",
    "./ai-client": {
      "types": "./packages/ai-client/src/index.ts",
      "import": "./packages/ai-client/dist/index.js",
      "default": "./packages/ai-client/dist/index.js"
    },
    "./ai-client/browser": "./packages/ai-client/dist/browser.js"
  }
}
