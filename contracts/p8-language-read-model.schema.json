{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://languages.thiepn.dev/contracts/p8-language-read-model.schema.json",
  "title": "THIEPN Language Read Model P8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema","schemaVersion","readModelVersion","packageVersion","generatedAt",
    "appId","languageId","producerRevision","presentation","enrollment","workload",
    "activity","progress","proficiency","nextAction","source"
  ],
  "properties": {
    "schema": {"const":"thiepn-language-read-model"},
    "schemaVersion": {"const":1},
    "readModelVersion": {"const":"p8-read-model-v1"},
    "packageVersion": {"type":"string"},
    "generatedAt": {"type":"string","format":"date-time"},
    "appId": {"type":"string","minLength":1},
    "languageId": {"type":"string","minLength":1},
    "producerRevision": {"type":"string","minLength":1},
    "presentation": {
      "type":"object","additionalProperties":false,
      "required":["displayName"],
      "properties":{
        "displayName":{"type":"string","minLength":1},
        "nativeName":{"type":"string","minLength":1},
        "appRoute":{"type":"string","minLength":1}
      }
    },
    "enrollment":{
      "type":"object","additionalProperties":false,
      "required":["status"],
      "properties":{
        "status":{"enum":["active","paused","completed","inactive"]},
        "startedAt":{"type":"string","format":"date-time"},
        "targetBand":{"type":"string","minLength":1}
      }
    },
    "workload":{
      "type":"object","additionalProperties":false,
      "required":["dueItems","newItems","practiceItems","courseItems","totalItems"],
      "properties":{
        "dueItems":{"type":"number","minimum":0},
        "newItems":{"type":"number","minimum":0},
        "practiceItems":{"type":"number","minimum":0},
        "courseItems":{"type":"number","minimum":0},
        "totalItems":{"type":"number","minimum":0},
        "estimatedMinutes":{"type":"number","minimum":0}
      }
    },
    "activity":{
      "type":"object","additionalProperties":false,
      "required":["todayEvents","sevenDayEvents","streakDays","lastStudiedAt"],
      "properties":{
        "todayEvents":{"type":"number","minimum":0},
        "sevenDayEvents":{"type":"number","minimum":0},
        "streakDays":{"type":"number","minimum":0},
        "lastStudiedAt":{"oneOf":[{"type":"string","format":"date-time"},{"type":"null"}]}
      }
    },
    "progress":{
      "type":"object","additionalProperties":false,
      "required":["metrics"],
      "properties":{
        "metrics":{"type":"array","items":{
          "type":"object","additionalProperties":false,
          "required":["id","label","current"],
          "properties":{
            "id":{"type":"string","minLength":1},
            "label":{"type":"string","minLength":1},
            "current":{"type":"number"},
            "total":{"type":"number"},
            "unit":{"type":"string","minLength":1}
          }
        }}
      }
    },
    "proficiency":{
      "type":"object","additionalProperties":false,
      "required":["framework","claim","maintenanceNeeded","dimensions"],
      "properties":{
        "framework":{"type":"string","minLength":1},
        "claim":{"enum":["internal","external","none"]},
        "currentBand":{"type":"string","minLength":1},
        "frontierBand":{"type":"string","minLength":1},
        "maintenanceNeeded":{"type":"boolean"},
        "dimensions":{"type":"array","items":{
          "type":"object","additionalProperties":false,
          "required":["id","label"],
          "properties":{
            "id":{"type":"string","minLength":1},
            "label":{"type":"string","minLength":1},
            "score":{"type":"number","minimum":0,"maximum":1},
            "confidence":{"type":"number","minimum":0,"maximum":1},
            "band":{"type":"string","minLength":1},
            "evidenceCount":{"type":"number","minimum":0}
          }
        }}
      }
    },
    "nextAction":{
      "type":"object","additionalProperties":false,
      "required":["id","label","kind","priority"],
      "properties":{
        "id":{"type":"string","minLength":1},
        "label":{"type":"string","minLength":1},
        "kind":{"enum":["study","review","learn","practice","course","assessment","immerse","maintain","none"]},
        "priority":{"type":"number","minimum":0,"maximum":100},
        "reason":{"type":"string"},
        "route":{"type":"string"}
      }
    },
    "source":{
      "type":"object","additionalProperties":false,
      "required":["authority"],
      "properties":{
        "authority":{"const":"consumer"},
        "stateRevision":{"type":"string","minLength":1},
        "contentVersion":{"type":"string","minLength":1}
      }
    }
  }
}
