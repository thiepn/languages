        "steps": [
          {
            "id": "zh-p18-encounter",
            "type": "encounter",
            "examples": [
              {
                "targetText": "是",
                "meaning": "to be",
                "reading": "shì"
              },
              {
                "targetText": "不是",
                "meaning": "is not",
                "reading": "bú shì"
              },
              {
                "targetText": "也是",
                "meaning": "also is",
                "reading": "yě shì"
              },
              {
                "targetText": "他是老师。",
                "meaning": "He is a teacher.",
                "reading": "Tā shì lǎoshī."
              }
            ]
          },
          {
            "id": "zh-p18-explain-form",
            "type": "explain",
            "heading": "Linking an identity noun",
            "explanation": "The original source defines 是 as often linking a subject with an identity noun. Its example 他是老师。 means 'He is a teacher.' This does not imply that every adjective sentence in Mandarin uses 是.",
            "conceptIds": []
