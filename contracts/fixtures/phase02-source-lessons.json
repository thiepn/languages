        "steps": [
          {
            "id": "fr-a1-01-encounter",
            "type": "encounter",
            "examples": [
              {
                "targetText": "Bonjour ! Je m’appelle Inès.",
                "meaning": "Hello! My name is Inès."
              },
              {
                "targetText": "Salut, Inès. Moi, c’est Malik.",
                "meaning": "Hi, Inès. I’m Malik."
              },
              {
                "targetText": "Bonsoir, monsieur.",
                "meaning": "Good evening, sir."
              },
              {
                "targetText": "Au revoir, à demain.",
                "meaning": "Goodbye, see you tomorrow."
              }
            ]
          },
          {
            "id": "fr-a1-01-explain",
            "type": "explain",
            "explanation": "Bonjour works in formal and informal daytime settings; salut is familiar and appropriate among friends. Use bonsoir in the evening. Say au revoir when leaving.",
            "conceptIds": [
              "etre"
            ]
          },
          {
            "id": "fr-p04-teach-contrast",
            "type": "explain",
            "heading": "Choose by context",
            "explanation": "Choose a French greeting for the relationship and time. Bonjour suits an unfamiliar teacher during the day. Bonsoir is an evening greeting; salut is informal, and au revoir closes a conversation. Je m’appelle introduces your name, whereas moi, c’est is more conversational. Written accents and apostrophes matter: a different spelling must not be silently treated as the same grammatical form.",
            "conceptIds": []
          },
