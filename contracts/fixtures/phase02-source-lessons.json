        "title": "Greetings at different times",
        "level": "A1",
        "objective": {
          "statement": "Distinguish morning, daytime, evening and bedtime expressions, then respond to a new meeting situation.",
          "skillDimension": "spoken_interaction"
        },
        "prerequisiteLessonIds": [],
        "publication": "internal-fixture",
