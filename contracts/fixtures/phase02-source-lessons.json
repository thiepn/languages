        "steps": [
          {
            "id": "ja-a1-encounter",
            "type": "encounter",
            "examples": [
              {
                "targetText": "朝：おはようございます。",
                "meaning": "Morning: Good morning (polite)."
              },
              {
                "targetText": "昼：こんにちは。",
                "meaning": "Daytime: Hello."
              },
              {
                "targetText": "夜：こんばんは。",
                "meaning": "Evening: Good evening."
              },
              {
                "targetText": "寝る前：おやすみなさい。",
                "meaning": "Before bed: Good night."
              },
              {
                "targetText": "先生：おはようございます。",
                "meaning": "Teacher: Good morning."
              }
            ]
          },
          {
            "id": "ja-a1-explain",
            "type": "explain",
            "explanation": "Japanese greetings respond to time and the situation. おはようございます is polite in the morning; こんにちは is a daytime greeting, and こんばんは is used in the evening. おやすみなさい is said when going to bed, not when meeting someone in the evening.",
            "conceptIds": []
          },
          {
            "id": "ja-p04-teach-contrast",
            "type": "explain",
            "heading": "Choose by context",
            "explanation": "Choose Japanese expressions by the action, not simply whether it is dark outside. こんばんは greets someone in the evening. おやすみなさい is said before going to sleep, not when arriving at an evening event. おはようございます is a polite morning greeting. こんにちは is a daytime greeting. The syllabic writing here does not establish the quality of a spoken pronunciation.",
            "conceptIds": []
          },
          {
            "id": "ja-a1-guided",
            "type": "guided",
            "exerciseIds": [
              "ja-a1-choice",
              "ja-a1-typed",
              "ja-p04-context-choice",
              "ja-p04-evening-arrival",
              "ja-p06-cloze",
              "ja-p06-ordering",
              "ja-p06-reading"
            ]
          },
          {
            "id": "ja-a1-independent",
            "type": "independent",
            "exerciseIds": [
              "ja-p04-transfer",
              "ja-a1-writing"
            ]
          },
          {
            "id": "ja-p04-reflection",
            "type": "reflect",
            "heading": "What to remember",
            "feedback": "Distinguish arriving in the evening (こんばんは) from going to bed (おやすみなさい). Morning おはようございます is polite; time and social context both matter. Producing written characters here does not certify speaking or listening."
          }
        ]
      },
