        "steps": [
          {
            "id": "ja-p15-encounter",
            "type": "encounter",
            "examples": [
              {
                "targetText": "ありがとうございます。",
                "meaning": "Thank you (polite)."
              },
              {
                "targetText": "どういたしまして。",
                "meaning": "You're welcome."
              },
              {
                "targetText": "すみません。",
                "meaning": "Excuse me / Sorry."
              },
              {
                "targetText": "はい、どうぞ。",
                "meaning": "Yes, here you go."
              }
            ]
          },
          {
            "id": "ja-p15-explain-forms",
            "type": "explain",
            "heading": "Thanks and the response",
            "explanation": "ありがとうございます expresses polite thanks. どういたしまして is one possible acknowledgment of thanks; it should not be treated as an obligatory answer to every apology. はい、どうぞ can accompany handing something to another person.",
            "conceptIds": []
          },
          {
            "id": "ja-p15-explain-use",
            "type": "explain",
            "heading": "Apology versus attention",
            "explanation": "すみません can express a light apology or politely draw someone's attention. Select it for getting a staff member's attention rather than answering thanks. The original lesson notes that いいえ is not always the natural reply to an apology. Written practice cannot assess politeness in actual speech.",
            "conceptIds": []
          },
          {
            "id": "ja-p15-guided",
            "type": "guided",
            "exerciseIds": [
              "ja-p15-thanks-guided",
              "ja-p15-attention-guided",
              "ja-p15-write-guided",
              "ja-p15-reply-guided",
              "ja-p15-hand-guided"
            ]
          },
          {
            "id": "ja-p15-independent",
            "type": "independent",
            "exerciseIds": [
              "ja-p15-attention-independent",
              "ja-p15-reply-independent",
              "ja-p15-intent-independent",
              "ja-p15-sequence-independent",
              "ja-p15-writing-independent"
            ]
          },
          {
            "id": "ja-p15-reflection",
            "type": "reflect",
            "heading": "What to remember",
            "feedback": "ありがとうございます thanks someone; どういたしまして can acknowledge thanks; すみません can draw attention or apologize. Choose by social function, not by a word-for-word English equivalent."
          }
        ]
      },
