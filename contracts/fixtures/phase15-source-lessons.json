        "steps": [
          {
            "id": "fr-p15-encounter",
            "type": "encounter",
            "examples": [
              {
                "targetText": "Nous sommes à Lyon.",
                "meaning": "We are in Lyon."
              },
              {
                "targetText": "Elles sont étudiantes.",
                "meaning": "They are students."
              },
              {
                "targetText": "Je suis professeur.",
                "meaning": "I am a teacher."
              },
              {
                "targetText": "Il est à Paris.",
                "meaning": "He is in Paris."
              },
              {
                "targetText": "Tu es étudiante ?",
                "meaning": "Are you a student?"
              },
              {
                "targetText": "Oui, je suis étudiante à Paris.",
                "meaning": "Yes, I am a student in Paris."
              },
              {
                "targetText": "Elle est française.",
                "meaning": "She is French."
              }
            ]
          },
          {
            "id": "fr-p15-explain-forms",
            "type": "explain",
            "heading": "Conjugate être",
            "explanation": "Être is irregular: je suis, tu es, il/elle/on est, nous sommes, vous êtes, ils/elles sont. The first-person form remains je suis, without elision. The original dialogue contrasts tu es étudiante ? with je suis étudiante.",
            "conceptIds": [
              "etre"
            ]
          },
          {
            "id": "fr-p15-explain-use",
            "type": "explain",
            "heading": "Describe a role or place",
            "explanation": "Être identifies occupations and locations. Je suis professeur uses no indefinite article in the original example; Nous sommes à Lyon locates a group. Adjectives normally agree with the person described: Elle est française, not Elle est français. These are authored written contrasts, not a spoken-proficiency test.",
            "conceptIds": []
          },
          {
            "id": "fr-p15-guided",
            "type": "guided",
            "exerciseIds": [
              "fr-p15-suis-guided",
              "fr-p15-vous-guided",
              "fr-p15-nous-guided",
              "fr-p15-aya-guided",
              "fr-p15-agreement-guided"
            ]
          },
          {
            "id": "fr-p15-independent",
            "type": "independent",
            "exerciseIds": [
              "fr-p15-role-independent",
              "fr-p15-place-independent",
              "fr-p15-people-independent",
              "fr-p15-ordre-independent",
              "fr-p15-writing-independent"
            ]
          },
          {
            "id": "fr-p15-reflection",
            "type": "reflect",
            "heading": "What to remember",
            "feedback": "Use the subject-specific present form of être. A role (je suis professeur) and a location (nous sommes à Lyon) have different meanings. Gender agreement matters in elle est française. No graded proficiency or review history is created."
          }
        ]
